# =====================================================================
# Git Ignore - Modern Python & Dokkan Battle Automation Bot
# =====================================================================

# Virtual Environment (uv / PEP 668)
.venv/

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing & Linters Cache
.pytest_cache/
.ruff_cache/
.coverage

# Build & Standalone Distribution Artifacts
build/
dist/
*.spec

# IDE & Editor Settings (preserving project configurations)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# Operating System Metadata
.DS_Store
Thumbs.db
ehthumbs.db

# Logs & Temporary Outputs
*.log

# Temporary Cache & Screenshots (preserve template/asset fixtures)
cache/
*.png
!templates/**/*.png
!assets/**/*.png
!docs/**/*.*
!src/dokkan_eza_link_farmer/assets/**/*.*

# Internal Prompts & Guidelines
GEMINI_MASTER_PROMPT.md
