# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/

# Linters, Type Checkers & Tooling
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Build & Packaging Artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/
*.spec

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# Operating System Metadata
.DS_Store
Thumbs.db
ehthumbs.db

# Logs & Runtime Dumps
*.log

# Cache & Temporary Screenshots
cache/
*.png
!templates/**/*.png
!assets/**/*.png
!assets/**/*.svg
